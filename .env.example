# Optional administrator access list for /admin/data-status.
ADMIN_EMAILS=owner@example.com

# Required only for POST /api/sync. Keep the production value secret.
CRON_SECRET=replace-with-a-long-random-value

# Optional normalized provider feed for future private adapters.
MOTORSPORT_API_KEY=

# Sites provides D1 through the DB binding in .openai/hosting.json.
# Supabase is not required by this deployment.
SUPABASE_URL=
SUPABASE_ANON_KEY=
