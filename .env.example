# Optional bearer token for /api/data-status. Store it as a Cloudflare secret.
ADMIN_TOKEN=replace-with-a-long-random-value

# Required only for POST /api/sync. Keep the production value secret.
CRON_SECRET=replace-with-a-long-random-value

# Optional normalized provider feed for future private adapters.
MOTORSPORT_API_KEY=

# Cloudflare D1 is attached through the DB binding in wrangler.jsonc.
# Supabase is optional and is not required by this deployment.
SUPABASE_URL=
SUPABASE_ANON_KEY=
